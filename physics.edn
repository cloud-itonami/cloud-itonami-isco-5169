;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a service-support robot performs supply setup,
;; equipment sanitation and cleanup. Declared here: equipment sanitation --
;; a steel tool tray heated in a dry-heat cabinet until its coolest face
;; reaches the holding temperature -- and supply setup: the tray lifted
;; from the prep bench into the cabinet.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-5169"
 :cases
 [{:id :tool-tray-dry-heat
   :kind :thermal
   :procedure "steel tool tray in a dry-heat cabinet at 170 C, heated from both faces by the cabinet air, until the whole tray is at 160 C"
   :params {:conductivity-w-mk 16.0 :density-kg-m3 7900.0 :specific-heat-j-kgk 500.0
            :t0-c 22.0 :t-hot-c 170.0 :h-front-w-m2k 15.0
            :t-back-ambient-c 170.0 :h-back-w-m2k 15.0
            :threshold-c 160.0 :duration-s 3000.0 :nodes 5}
   :sweep {:param :thickness-m :values [0.002 0.003 0.004 0.006 0.008]}
   :quantity :time-to-threshold-s
   :limit {:max 1800.0 :basis "estimate: a 30-minute warm-up so the sanitation cycle fits between appointments; cabinet h = 15 W/m2K (still air) is also an estimate"}
   :boundary {:lo 0.003 :hi 0.008}}
  {:id :tool-tray-into-cabinet
   :kind :manipulator
   :procedure "arm lifts the loaded tool tray from the prep bench into the sanitation cabinet shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 2.5
            :from [0.50 0.05] :to [0.35 0.45] :duration-s 1.8 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.5 3.0 4.5 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 45.0 :basis "estimate: continuous shoulder torque of a ~4 kg-payload collaborative arm"}
   :boundary {:lo 0.1 :hi 20.0}}]}
